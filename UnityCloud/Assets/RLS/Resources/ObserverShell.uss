.root { position: relative; flex-grow: 1; width: 100%; height: 100%; color: rgb(242, 242, 242); font-size: 16px; background-color: rgba(0, 0, 0, 0); }
.row { flex-direction: row; align-items: center; flex-wrap: wrap; }
.backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(0, 0, 0); align-items: center; justify-content: center; padding: 12px; }
.menu-card { width: 560px; max-width: 92%; max-height: 92%; padding: 28px; background-color: rgba(24, 24, 24, 0.98); border-radius: 8px; border-width: 1px; border-color: rgb(58, 58, 58); }
.hero-title { font-size: 38px; -unity-font-style: bold; margin-top: 12px; margin-bottom: 12px; white-space: normal; }
.subtitle { font-size: 20px; color: rgb(190, 190, 190); margin-bottom: 32px; }
.eyebrow { font-size: 12px; color: rgb(176, 176, 176); margin-top: 4px; }
.muted { color: rgb(160, 160, 160); font-size: 13px; white-space: normal; margin-top: 4px; margin-bottom: 8px; }
.backdrop .muted { color: rgb(180, 180, 180); }
.light-panel { background-color: rgba(27, 27, 27, 0.96); color: rgb(242, 242, 242); border-radius: 6px; border-width: 1px; border-color: rgb(58, 58, 58); padding: 16px; }
.light-panel .muted { color: rgb(174, 174, 174); }
.section-title { font-size: 22px; -unity-font-style: bold; white-space: normal; margin-bottom: 10px; margin-top: 4px; }
.action { min-height: 36px; padding: 8px 12px; margin: 3px; border-radius: 4px; border-width: 1px; border-color: rgb(84, 84, 84); background-color: rgb(40, 40, 40); color: rgb(242, 242, 242); white-space: normal; }
.action:hover { background-color: rgb(60, 60, 60); }
.action:focus { border-width: 2px; border-color: rgb(220, 220, 220); }
.action:active { background-color: rgb(76, 76, 76); }
.action.primary { background-color: rgb(232, 232, 232); color: rgb(20, 20, 20); -unity-font-style: bold; }
.action.primary:hover { background-color: rgb(255, 255, 255); }
.topbar { position: absolute; top: 0; left: 0; right: 0; height: 76px; padding: 10px 18px; background-color: rgba(0, 0, 0, 0.98); border-bottom-width: 1px; border-bottom-color: rgb(48, 48, 48); }
.identity { flex-grow: 1; min-width: 200px; }
.brand { font-size: 18px; -unity-font-style: bold; }
.clock { margin-right: 20px; align-items: center; }
.clock-text { font-size: 16px; }
.inspector { position: absolute; top: 92px; bottom: 40px; right: 16px; width: 350px; max-width: 44%; }
.inspector > .unity-scroll-view { flex-grow: 1; }
.metric { justify-content: space-between; border-bottom-width: 1px; border-bottom-color: rgb(58, 58, 58); min-height: 34px; }
.metric-name { font-size: 13px; }
.metric-value { -unity-font-style: bold; font-size: 15px; }
.works { max-height: 240px; }
.work-card { padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgb(58, 58, 58); }
.work-title { font-size: 15px; white-space: normal; }
.event-feed { position: absolute; left: 16px; right: 382px; bottom: 40px; height: 190px; }
.event-feed.wide-feed { right: 16px; }
.feed-title { -unity-font-style: bold; font-size: 13px; margin-right: 8px; }
.event-feed .action { font-size: 12px; min-height: 28px; padding: 4px 7px; }
.event-feed > .unity-scroll-view { flex-grow: 1; }
.event-item { margin-top: 6px; }
.body-copy { white-space: normal; margin: 10px 0; }
.save-status { position: absolute; bottom: 10px; left: 20px; font-size: 12px; color: rgb(242, 242, 242); background-color: rgba(24, 24, 24, 0.94); padding: 3px 8px; border-radius: 4px; border-width: 1px; border-color: rgb(64, 64, 64); }
.modal { background-color: rgba(0, 0, 0, 0.92); }
.snapshot-list { max-height: 440px; }
.logo { height: 240px; margin-top: 20px; }
.error-banner { position: absolute; left: 20px; right: 20px; bottom: 40px; padding: 16px; background-color: rgb(82, 30, 32); color: rgb(255, 242, 242); white-space: normal; border-width: 1px; border-color: rgb(154, 72, 72); }
.high-contrast .light-panel { background-color: rgb(255, 255, 255); color: rgb(0, 0, 0); border-color: rgb(0, 0, 0); }
.high-contrast .muted { color: rgb(48, 48, 48); }
.unity-foldout { margin-top: 8px; }
.unity-progress-bar { height: 48px; margin-top: 20px; }

/* Runtime viewport classes are set by the Toolkit controller for browser-sized windows. */
.compact-viewport .topbar { height: auto; min-height: 76px; padding: 8px 10px; }
.compact-viewport .identity { min-width: 170px; }
.compact-viewport .clock { margin-right: 8px; }
.compact-viewport .inspector { top: 116px; right: 10px; bottom: 148px; width: 40%; max-width: 350px; }
.compact-viewport .event-feed { left: 10px; right: 10px; bottom: 10px; height: 128px; max-height: 28%; }
.compact-viewport .save-status { bottom: 142px; left: 12px; }
.compact-viewport .error-banner { left: 10px; right: 10px; bottom: 142px; padding: 10px; }
.compact-viewport .menu-card { padding: 18px; }
.compact-viewport .hero-title { font-size: 30px; }
.compact-viewport .subtitle { font-size: 17px; margin-bottom: 18px; }
.compact-viewport .logo { height: 150px; margin-top: 8px; }
.compact-viewport .action { min-height: 32px; padding: 6px 9px; margin: 2px; }
.narrow-viewport .topbar { padding: 6px; }
.narrow-viewport .identity { min-width: 130px; }
.narrow-viewport .brand { font-size: 15px; }
.narrow-viewport .clock-text { font-size: 13px; }
.narrow-viewport .inspector { top: 148px; right: 8px; bottom: 132px; width: 66%; max-width: 320px; }
.narrow-viewport .event-feed { left: 8px; right: 8px; bottom: 8px; height: 112px; max-height: 26%; }
.narrow-viewport .save-status { bottom: 120px; left: 8px; }
.narrow-viewport .error-banner { left: 8px; right: 8px; bottom: 120px; padding: 8px; }
.narrow-viewport .menu-card { max-height: 94%; padding: 12px; }
.narrow-viewport .hero-title { font-size: 25px; }
.narrow-viewport .subtitle { font-size: 15px; margin-bottom: 12px; }
.narrow-viewport .logo { height: 100px; margin-top: 4px; }
.narrow-viewport .action { min-height: 30px; padding: 5px 7px; font-size: 12px; }
.narrow-viewport .section-title { font-size: 19px; }
